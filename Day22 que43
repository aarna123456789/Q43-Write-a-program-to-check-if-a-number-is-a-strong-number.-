#include<stdio.h>
int main()
{
int n,original,i,digit,factorial,sum=0;
printf("enter a number");
scanf("%d",&n);
original=n;
while(n!=0)
{
digit=n%10;
factorial=1;
for(i=1;i<=digit;i++)
{
factorial=factorial*i;
}
sum=sum+factorial;
n=n/10;
}
if(sum==original)
printf("strong number");
else 
printf("not a strong number");
return 0;
}
